module ZombieData exposing (benchmark, current)

import Array
import Base64
import BenchmarkGltf.Animation
import BenchmarkGltf.Query.AnimationHelper as BAnimationHelper
import BenchmarkGltf.Query.BufferStore as BBufferStore
import BenchmarkGltf.Query.SkinHelper as BSkinHelper
import BenchmarkGltf.Skin
import BenchmarkInternal.Gltf
import Bytes exposing (Bytes)
import Bytes.Decode
import Gltf.Animation
import Gltf.Query.AnimationHelper as AnimationHelper
import Gltf.Query.BufferStore as BufferStore
import Gltf.Query.SkinHelper as SkinHelper
import Gltf.Skin
import Internal.Gltf


current : Maybe { animations : List Gltf.Animation.Animation, skins : List Gltf.Skin.Skin }
current =
    get
        (Bytes.Decode.decode (Internal.Gltf.bytesDecoder ""))
        BufferStore.init
        AnimationHelper.extractAnimations
        SkinHelper.skinAtIndex
        Gltf.Skin.Index


benchmark : Maybe { animations : List BenchmarkGltf.Animation.Animation, skins : List BenchmarkGltf.Skin.Skin }
benchmark =
    get
        (Bytes.Decode.decode (BenchmarkInternal.Gltf.bytesDecoder ""))
        BBufferStore.init
        BAnimationHelper.extractAnimations
        BSkinHelper.skinAtIndex
        BenchmarkGltf.Skin.Index


get :
    (Bytes -> Maybe { a | skins : Array.Array b })
    -> ({ a | skins : Array.Array b } -> store)
    -> ({ a | skins : Array.Array b } -> store -> animations)
    -> ({ a | skins : Array.Array b } -> store -> index -> Maybe skin)
    -> (Int -> index)
    -> Maybe { animations : animations, skins : List skin }
get fDecodeBytes fBufferStoreInit fExtractAnimations fSkinAtIndex fIndex =
    bytes
        |> Base64.toBytes
        |> Maybe.andThen fDecodeBytes
        |> Maybe.map
            (\gltf ->
                let
                    store : store
                    store =
                        fBufferStoreInit gltf
                in
                { animations = fExtractAnimations gltf store
                , skins =
                    List.range 0 (Array.length gltf.skins - 1)
                        |> List.filterMap (\i -> fSkinAtIndex gltf store (fIndex i))
                }
            )


bytes : String
bytes =
    ""
